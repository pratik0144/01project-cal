---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Online Overtime Calculator — Calculate OT Pay for All 50 States (2026)",
  description = "Free overtime calculator for all 50 U.S. states. Calculate straight time, overtime (1.5×), and double time (2×) pay with state-specific rules. Updated for 2026."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="OvertimeCalculator" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Fonts: swap for perf -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Dark mode: apply before paint to prevent flash -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <slot />
  </body>
</html>
