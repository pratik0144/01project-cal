---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Calculator from '../../components/Calculator.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';
import SeoContent from '../../components/SeoContent.astro';
import overtimeData from '../../data/overtime-rules.json';

export function getStaticPaths() {
  const paths = overtimeData.states.map((s: any) => ({
    params: { state: s.slug },
    props: {
      isLanding: false,
      stateName: s.state,
      abbr: s.abbr,
      slug: s.slug,
      pageTitle: s.seo?.page_title || `${s.state} Overtime Calculator (2026)`,
      h1: s.seo?.h1 || `${s.state} Overtime Calculator`,
      uniqueRule: s.seo?.unique_rule_sentence || s.governing_law || '',
      keywords: s.seo?.secondary_keywords || [],
    },
  }));

  paths.push({
    params: { state: 'select-state' },
    props: {
      isLanding: true,
      stateName: 'Select State',
      abbr: 'US',
      slug: 'select-state',
      pageTitle: 'Online Overtime Calculator - Calculate OT Pay for All 50 States (2026)',
      h1: 'Overtime & Pay Calculator',
      uniqueRule: 'Select your state to calculate exact overtime pay with local rules, or compute standard federal overtime (1.5× after 40 hours).',
      keywords: [],
    },
  });

  return paths;
}

const { isLanding, stateName, abbr, slug, pageTitle, h1, uniqueRule, keywords } = Astro.props;

const description = isLanding
  ? 'Free overtime calculator for all 50 U.S. states. Calculate straight time, overtime (1.5×), and double time (2×) with state-specific rules. Updated for 2026.'
  : `Free ${stateName} overtime calculator. ${uniqueRule} Calculate your OT pay instantly with ${abbr} state-specific rules for 2026.`;

const stateKeywords = isLanding
  ? ''
  : `${stateName} overtime calculator, ${abbr} overtime calculator, overtime pay ${stateName}, ${stateName} OT rules 2026, calculate overtime ${stateName}, ${keywords.join(', ')}`;
---

<Layout
  title={pageTitle}
  description={description}
  keywords={stateKeywords}
>
  <Navbar />
  <main class="flex-1">
    <!-- State-specific heading / Landing heading -->
    <div class="section-container pt-6 sm:pt-8 text-center">
      <p class="mono-eyebrow mb-2">
        {isLanding ? 'ALL 50 U.S. STATES • 2026 RULES' : `${abbr} OVERTIME RULES • 2026`}
      </p>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl">{h1}</h1>
      {uniqueRule && (
        <p class="mt-2 text-sm sm:text-base max-w-2xl mx-auto" style="color: var(--color-g-body);">
          {uniqueRule}
        </p>
      )}
    </div>

    <!-- Calculator -->
    <Calculator defaultState={slug} hideTitle={true} />

    <div class="section-container">
      <hr class="my-8 sm:my-12" style="border-color: var(--color-g-hairline);" />
    </div>

    <!-- Full Existing SEO content, with 1-2 small state sections inserted for specific state -->
    <SeoContent stateName={stateName} abbr={abbr} slug={slug} />

    <div class="section-container">
      <hr class="my-8 sm:my-12" style="border-color: var(--color-g-hairline);" />
    </div>

    <!-- FAQ Section on EVERY page -->
    <FAQ />
  </main>
  <Footer />
</Layout>
